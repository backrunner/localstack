{
  "name": "unplugin-localstack",
  "version": "0.1.0",
  "description": "Register frontend development servers with LocalStack",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
