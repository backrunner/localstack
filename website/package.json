{
  "name": "@localstack/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "svedocs dev",
    "build": "svedocs build --mode edge",
    "preview": "svedocs preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:content": "svedocs check --translations --strict",
    "deploy": "npm run check && npm run check:content && npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.0",
    "svelte": "^5.57.2",
    "svedocs": "0.3.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.13"
  },
  "devDependencies": {
    "svedocs-cli": "0.3.0",
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3",
    "svelte-check": "^4.7.6",
    "wrangler": "4.151.1",
    "sharp": "0.35.5",
    "@playwright/test": "1.60.0"
  },
  "packageManager": "npm@11.18.0",
  "overrides": {
    "sharp": "$sharp"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
